        <attribute name="edited" value="TWFpY29sO01BSUNPTDsyMDI2LTAzLTA1OzA5OjM0OjMwIGEu4oCvbS47MTsxMDgwMw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Numero, i" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese un numero entre 1 y 10&quot;" newline="True"/>
            <input variable="Numero"/>
            <if expression="&quot;Numero &gt;1 y Numero &lt;10&quot;">
                <then/>
                <else>
                    <output expression="&quot;El Numero ingresado no esta entre 1 y 10 por favor, intente de nuevo&quot;" newline="True"/>
                </else>
            </if>
            <for variable="i" start="10" end="-1" direction="inc" step="1">
                <output expression="&quot;Numero,&quot;*&quot;,i,&quot;=&quot;,Numero*i&quot;" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
